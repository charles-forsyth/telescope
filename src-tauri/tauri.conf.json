{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telescope",
  "version": "0.1.0",
  "identifier": "edu.ucr.researchcomputing.telescope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Telescope",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Research cloud fleet spend and resources, read-only",
    "longDescription": "Telescope is a read-only desktop viewer for a fleet of Google Cloud research projects: spend, budgets, compute, access and exposure. Powered by the Skywalker MCP server.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": null,
      "dmg": {
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 },
        "windowSize": { "width": 660, "height": 420 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English"] },
      "wix": { "language": "en-US" },
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
